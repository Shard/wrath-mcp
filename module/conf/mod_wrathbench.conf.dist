#
# mod-wrathbench configuration
#
# Copy to mod_wrathbench.conf to override; .conf.dist is the distributed default.
#

[worldserver]

########################################
# WrathBench
########################################
#
#    WrathBench.Enable
#        Description: Enable the WrathBench control module (HTTP/WS bridge).
#                     Off unless set: a worldserver that merely has the module
#                     built in opens no control port. Set 1 here (or
#                     AC_WRATH_BENCH_ENABLE=1 in the environment) to turn it on.
#        Default:     0 - Disabled
#                     1 - Enabled
#

WrathBench.Enable = 0

#
#    WrathBench.BindAddress
#        Description: Address the module's HTTP/WebSocket server binds to.
#                     Loopback by default: only processes on the
#                     worldserver's own host reach it. The port is plain HTTP
#                     with bearer secrets, so widen it ("0.0.0.0", or one
#                     interface's address) only onto a private network that
#                     nothing publishes beyond the hosts that should reach it
#                     (in a container, an unpublished port on a private
#                     network), or put a TLS proxy in front of it.
#        Default:     "127.0.0.1"
#

WrathBench.BindAddress = "127.0.0.1"

#
#    WrathBench.Port
#        Description: TCP port for the HTTP/WebSocket server.
#        Default:     8086
#

WrathBench.Port = 8086

#
#    WrathBench.Threads
#        Description: Worker threads for the HTTP/WebSocket io_context. These
#                     threads never touch game state; all game work is marshalled
#                     onto the world thread.
#        Default:     2
#

WrathBench.Threads = 2

#
#    WrathBench.Account
#        Description: Default auth account a session attaches to when the
#                     /session request omits "account". Must already exist in the
#                     auth DB (`account create <name> <password>` on the
#                     worldserver console).
#        Default:     "RUNNER"
#

WrathBench.Account = "RUNNER"

#
#    WrathBench.Accounts
#        Description: Comma-separated allowlist of auth accounts the module
#                     serves (case-insensitive). Every surface that takes an
#                     "account" parameter (/session, /characters,
#                     /character-delete) refuses accounts not on this list with
#                     403 account_not_permitted.
#                     A deployment that runs several accounts sets its own list
#                     in its own config, so what ships is the single-account
#                     default.
#        Default:     the WrathBench.Account value (single-account behaviour)
#

WrathBench.Accounts = "RUNNER"

#
#    WrathBench.Secret
#        Description: The port secret (PROTOCOL.md, "Authentication"). Every
#                     HTTP request and /events upgrade must carry
#                     `Authorization: Bearer <credential>`; this value is the
#                     operator credential that may use every route, and the one
#                     the sandbox host presents to lease per-session secrets. At
#                     least 32 characters; with it unset or shorter the module
#                     does not listen at all. Never put a real value in this
#                     file: pass it as AC_WRATH_BENCH_SECRET in the
#                     worldserver's environment.
#        Default:     "" (control surface disabled)
#

WrathBench.Secret = ""

#
#    WrathBench.AuditDir
#        Description: Directory for per-session audit logs (JSONL, one file per
#                     session token). Every action dispatched and event served is
#                     logged here with a timestamp and session id (docs/CONTRACTS.md).
#                     The default is the AzerothCore Docker image's log path;
#                     elsewhere, point it at a writable directory.
#        Default:     "/azerothcore/env/dist/logs/wrathbench"
#

WrathBench.AuditDir = "/azerothcore/env/dist/logs/wrathbench"

#
#    WrathBench.ActionRate
#    WrathBench.ActionBurst
#        Description: The request rate one lease may sustain, per second, and
#                     the burst it may spend at once (a token bucket per
#                     lease). It covers what a lease secret may ask of the
#                     world thread: POST /action (raw included), POST /session,
#                     DELETE /session and the /events upgrade. A request over
#                     it is answered 429 rate_limited and nothing is
#                     dispatched. The port secret is exempt. Off by default:
#                     a snippet's awaited actions one after another can
#                     exceed any fixed rate, so a world whose callers are all
#                     the operator's own changes nothing. Set it where a
#                     caller holding only a lease secret is not trusted (a
#                     hosted world); 20 and 40 are several times what one
#                     character's client sends, there so that such a caller
#                     cannot occupy the world thread, not to pace play.
#                     Nothing checks that a hosted deployment has set it: a
#                     world that hands lease secrets to callers it does not
#                     trust sets it, in its own conf.
#                     Re-read on `.reload config`.
#        Default:     0 (no limit) and 40
#                     Hosted:      20 and 40
#

WrathBench.ActionRate = 0
WrathBench.ActionBurst = 40

#
#    WrathBench.EventsSubscribersPerToken
#        Description: Concurrent /events subscribers one lease secret may hold
#                     on its token. An upgrade past it is refused 429
#                     subscriber_limit. One consumer holds one socket; the
#                     rest is room for a reconnect that overlaps a socket the
#                     server has not yet seen close. Subscribers that present
#                     the port secret are neither counted nor refused.
#                     Re-read on `.reload config`.
#        Default:     4
#                     0 - No limit
#

WrathBench.EventsSubscribersPerToken = 4

#
#    WrathBench.MaxLeases
#        Description: Leases the module holds at once. POST /lease for a new
#                     token past it is refused 429 lease_limit; re-leasing a
#                     token already held never is. The module forgets a lease
#                     only on DELETE /lease, so this bounds what a caller that
#                     leases and never releases can leave behind. Size it to
#                     the characters the deployment runs at once, with room.
#                     Re-read on `.reload config`.
#        Default:     1024
#                     0 - No limit
#

WrathBench.MaxLeases = 1024

#
#    WrathBench.MaxConnections
#    WrathBench.MaxConnectionsPerPeer
#    WrathBench.MaxConnectionsPerLease
#        Description: Open connections to the port, HTTP and WebSocket
#                     together: in total, from one peer address, and
#                     authenticated by one lease's secret. A connection past
#                     the total or the per-peer limit is closed at accept,
#                     unanswered; a request that would make its connection
#                     one more than its lease may hold is answered 429
#                     connection_limit and the connection closed.
#                     Keep the total under the worldserver's open-file limit
#                     with room for the game's own sockets. Connections on
#                     which no request has authenticated yet may hold at most
#                     half of it, and each has ten seconds to send one, so
#                     that a caller with no credential cannot take the table
#                     from those that have shown one. The per-peer limit
#                     is off by default because a deployment's own callers
#                     usually share one address (one host runs every sandbox);
#                     set it where callers that do not trust each other reach
#                     the port from addresses of their own, so that one cannot
#                     take every connection. The per-lease limit is what
#                     tells such callers apart where they do share an
#                     address. It is off by default because a caller's
#                     concurrent requests each hold a connection, so a world
#                     whose callers are all the operator's own changes
#                     nothing; 32 leaves a character its event sockets and
#                     more requests in flight than a client makes. The port
#                     secret's connections are never counted against a lease.
#                     Read at startup only.
#        Default:     4096, 0 and 0
#                     Hosted:      per lease 32
#                     0 - No limit
#

WrathBench.MaxConnections = 4096
WrathBench.MaxConnectionsPerPeer = 0
WrathBench.MaxConnectionsPerLease = 0

#
#    WrathBench.EventsBacklogBytes
#        Description: Bytes of events one /events subscriber may have queued
#                     and unsent. A subscriber past it has stopped reading, or
#                     reads slower than its session produces: it is dropped
#                     (it sees a closed socket, as for any connection loss)
#                     rather than left to grow in the worldserver's memory.
#                     The default is meant to sit well above the largest burst a
#                     session's stream carries (the reattach replay in a busy
#                     place). Read at startup only.
#        Default:     16777216 (16 MiB)
#                     0 - No limit
#

WrathBench.EventsBacklogBytes = 16777216
